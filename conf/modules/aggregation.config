process {

    withName: AGGREGATE_RESULTS {
        publishDir = [
            path: { "${params.outdir}/aggregated" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'NFCORE_STABLEEXPRESSION:STABLEEXPRESSION:MERGE_DATA:PLATFORM' {
        tag = { "${meta.platform}" }
        maxForks = 1
    }

    withName: 'NFCORE_STABLEEXPRESSION:STABLEEXPRESSION:GENE_STATISTICS:PLATFORM' {
        tag = { "${meta.platform}" }
        maxForks = 1
    }

}
