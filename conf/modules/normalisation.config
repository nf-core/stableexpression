process {

    withName: 'NORMALISATION_DESEQ2|NORMALISATION_EDGER' {
        publishDir = [
            path: { "${params.outdir}/normalised/${meta.dataset}/${task.process.tokenize(':')[-1].toLowerCase()}/" },
            mode: params.publish_dir_mode
        ]
    }

    withName: QUANTILE_NORMALISATION {
        publishDir = [
            path: { "${params.outdir}/quantile_normalised/${meta.dataset}/" },
            mode: params.publish_dir_mode
        ]
    }

}
