/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.
    It tests the different ways to use the pipeline, with small data

    Use as follows:
        nextflow run nf-core/stableexpression -profile test_dataset,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    species = 'drosophila simulans'
    datasets = "tests/test_data/input_datasets/drosophila_simulans/samplesheet.yaml"
    skip_fetch_eatlas_accessions = true
    skip_id_mapping = true
    target_genes = "FBgn0268332"
    gff_url = 'https://ftp.ebi.ac.uk/ensemblgenomes/pub/release-62/metazoa/gff3/drosophila_simulans/Drosophila_simulans.ASM75419v3.62.gff3.gz'
    nb_sections = 20
    outdir = "results/test_dsim"
}
