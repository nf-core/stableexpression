/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.
    It tests the different ways to use the pipeline, with small data

    Use as follows:
        nextflow run nf-core/stableexpression -profile test_dataset,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    species = 'beta_vulgaris'
    datasets = "tests/test_data/workflows/sampled/beta_vulgaris/samplesheet.csv"
    skip_fetch_eatlas_accessions = true
    skip_id_mapping = true
    normalisation_method = 'cpm'
    nb_sections = 1
    skip_genorm = true
    outdir = "results/test_dataset_format"
}
