/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    withName: 'EXPRESSIONATLAS_GETACCESSIONS|GEO_GETACCESSIONS' {
        ext.args = {
            def args = []
            if (params.platform)             { args << "--platform $params.platform" }
            if (params.keywords)             { args << "--keywords $params.keywords" }
            if (params.random_sampling_size) { args << "--random-sampling-size $params.random_sampling_size" }
            if (params.random_sampling_seed) { args << "--random-sampling-seed \"${params.random_sampling_seed}\"" }
            args.join(' ')
        }
    }

    withName: 'GPROFILER_IDMAPPING' {
        ext.args   = {  "--target-db $params.gprofiler_target_db" }
    }

    withName: 'DETECT_RARE_GENE_IDS' {
        ext.args   = { [
            "--min-occurrence-frequency $params.min_occurrence_freq",
            "--min-occurrence-quantile $params.min_occurrence_quantile"
        ].join(' ').trim() }
    }

    withName: 'FILTER_GENES' {
        ext.args   = { "--max-zero-ratio $params.gene_max_zero_ratio" }
    }

    withName: 'FILTER_SAMPLES' {
        ext.args   = { [
            "--max-null-ratio $params.sample_max_null_ratio",
            "--max-zero-ratio $params.sample_max_zero_ratio"
        ].join(' ').trim() }
    }

    withName: 'GET_CANDIDATE_GENES' {
        ext.args   = {  params.nb_candidates_per_section ? "--nb-candidates-per-section $params.nb_candidates_per_section": '' }
    }

    withName: 'COMPUTE_GENE_STATISTICS' {
        ext.args   = { "--max-ratio-null-valid-sample $params.max_null_ratio_valid_sample" }
    }

    withName: 'MAKE_SECTIONS' {
        ext.args   = { "--nb-sections $params.nb_sections" }
    }

    withName: 'PLATFORM_STABILITY_SCORE' {
        ext.args   = { "--weights $params.stability_score_weights" }
    }

    withName: 'GLOBAL_STABILITY_SCORE' {
        ext.args   = { [
            "--std-penalty-weight $params.stability_score_std_penalty_weight",
            "--null-penalty-weight $params.stability_score_null_penalty_weight"
        ].join(' ').trim() }
    }

    withName: 'AGGREGATE_RESULTS' {
        ext.args   = { "--nb-genes-plotted $params.multiqc_nb_genes_plotted" }
    }

    withName: 'MULTIQC' {
        label = { 'process_high' }
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
    }

}
