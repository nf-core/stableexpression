/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.
    It tests the different ways to use the pipeline, with small data

    Use as follows:
        nextflow run nf-core/stableexpression -profile test_dataset,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    species = 'mus musculus'
    nb_sections = 1
    nb_candidates_per_section = 1000
    datasets = "https://raw.githubusercontent.com/nf-core/test-datasets/stableexpression/test_data/mus_musculus/samplesheet.yaml"
    skip_fetch_eatlas_accessions = true
    gff_url = 'https://ftp.ensembl.org/pub/release-116/gff3/mus_musculus/Mus_musculus.GRCm39.116.gff3.gz'
    outdir = "results/test_mus_musculus"
}
