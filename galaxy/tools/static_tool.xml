<tool id="nf_core_stableexpression" name="nf-core/stableexpression" version="1.0.0">
    <description>DESCRIPTION</description>
    <version_command><![CDATA[
VERSION="PIPELINE_VERSION"; echo "$VERSION"
    ]]></version_command>
    <requirements>
        <requirement type="package" version="NEXTFLOW_VERSION">nextflow</requirement>
        <requirement type="package" version="SINGULARITY_VERSION">singularity</requirement>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
        nextflow run OlivierCoen/stableexpression
            -r 1.0dev -latest
            -profile singularity
            --outdir ./results
            PARAMETERS
    ]]>
    </command>
    <inputs>
INPUTS
    </inputs>
    <outputs>
        <data format="zip" name="results" label="${tool.name} on ${species.name}" from_work_dir="results.zip" />
    </outputs>
    <tests>
        <test>
            <param name="input1" value="2.fastq"/>
            <output name="output1" file="2.fasta"/>
        </test>
    </tests>
    <help><![CDATA[

Usage:   nextflow run nf-core/stableexpression -profile <profile(s)> --species <species> --outdir <outdir> [options]

Options:
USAGE_OPTIONS

     ]]></help>
    <citations>
        <citation type="bibtex">
            @misc{githubseqtk,
              author = {LastTODO, FirstTODO},
              year = {TODO},
              title = {seqtk},
              publisher = {GitHub},
              journal = {GitHub repository},
              url = {https://github.com/lh3/seqtk},
            }
        </citation>
    </citations>
</tool>
