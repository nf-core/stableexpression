<tool id="nf_core_stableexpression" name="nf-core/stableexpression" version="PIPELINE_VERSION">
    <description>DESCRIPTION</description>
    <requirements>
        <requirement type="package" version="NEXTFLOW_VERSION">nextflow</requirement>
        <requirement type="package" version="APPTAINER_VERSION">apptainer</requirement>
        <requirement type="package" version="OPENJDK_VERSION">openjdk</requirement>
    </requirements>
    <version_command><![CDATA[
VERSION="PIPELINE_VERSION"; echo "$VERSION"
    ]]></version_command>
    <command detect_errors="exit_code"><![CDATA[

        ## ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        ## Building new samplesheet with renamed files
        ## ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

        #if $input_output_options.datasets.provide_datasets == "true":

            #set $count_filenames = ''
            #for $count_dataset in $input_output_options.datasets.count_datasets
                #set $count_filenames += ' ' + str($count_dataset.name)
            #end for

            #set $design_filenames = ''
            #for $experimental_design in $input_output_options.datasets.experimental_designs
                #set $design_filenames += ' ' + str($experimental_design.name)
            #end for

            python '${__tool_directory__}/rebuild_samplesheet.py'
                --in $input_output_options.datasets.samplesheet
                --out renamed_samplesheet.csv
                --count-files $input_output_options.datasets.count_datasets
                --count-filenames $count_filenames
                --design-files $input_output_options.datasets.experimental_designs
                --design-filenames $design_filenames

        #else:
            echo "No user dataset provided"

        #end if

        ## ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        ## Running pipeline
        ## ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

        && nextflow drop -f OlivierCoen/stableexpression
        && nextflow run OlivierCoen/stableexpression
            -r dev -latest
            -profile apptainer
            -ansi-log false
            --outdir ./results
PARAMETERS

    ]]>
    </command>
    <inputs>
INPUTS
    </inputs>
    <outputs>
        <data name="multiqc_report" label="MultiQC report" from_work_dir="results/multiqc/multiqc_report.html" format="html" />
        <data name="top_stable_genes_summary" label="Top stable genes table" from_work_dir="results/gene_statistics/top_stable_genes_summary.csv" format="csv" />
    </outputs>
    <tests>
        <test>
            <param name="species" value="solanum_tuberosum"/>
            <param name="skip_fetch_eatlas_accessions" value="true"/>
            <param name="provide_datasets" value="true"/>
            <param name="samplesheet" value="input.csv"/>
            <param name="count_datasets" value="microarray.normalised.csv,rnaseq.raw.csv"/>
            <param name="experimental_designs" value="microarray.normalised.design.csv,rnaseq.raw.design.csv"/>
            <output name="top_stable_genes_summary">
                <assert_contents>
                    <has_text text="Rank,ensembl_gene_id,stability_score,standard_deviation,variation_coefficient,mean,expression_level_status,total_nb_nulls,nb_nulls_valid_samples,name,description,original_gene_ids" />
                </assert_contents>
            </output>
            <output name="multiqc_report">
                <assert_contents>
                    <has_text text="MultiQC: A modular tool" />
                    <has_text text="Data was processed using nf-core/stableexpression" />
                </assert_contents>
            </output>
        </test>
        <test>
            <param name="species" value="beta vulgaris"/>
            <param name="eatlas_keywords" value="leaf"/>
            <output name="top_stable_genes_summary">
                <assert_contents>
                    <has_text text="Rank,ensembl_gene_id,stability_score,standard_deviation,variation_coefficient,mean,expression_level_status,total_nb_nulls,nb_nulls_valid_samples,name,description,original_gene_ids" />
                </assert_contents>
            </output>
            <output name="multiqc_report">
                <assert_contents>
                    <has_text text="MultiQC: A modular tool" />
                    <has_text text="Data was processed using nf-core/stableexpression" />
                </assert_contents>
            </output>
        </test>
        <test>
            <param name="species" value="beta vulgaris"/>
            <param name="provide_datasets" value="true"/>
            <param name="samplesheet" value="input.csv"/>
            <param name="count_datasets" value="microarray.normalised.csv,rnaseq.raw.csv"/>
            <param name="experimental_designs" value="microarray.normalised.design.csv,rnaseq.raw.design.csv"/>
            <output name="top_stable_genes_summary">
                <assert_contents>
                    <has_text text="Rank,ensembl_gene_id,stability_score,standard_deviation,variation_coefficient,mean,expression_level_status,total_nb_nulls,nb_nulls_valid_samples,name,description,original_gene_ids" />
                </assert_contents>
            </output>
            <output name="multiqc_report">
                <assert_contents>
                    <has_text text="MultiQC: A modular tool" />
                    <has_text text="Data was processed using nf-core/stableexpression" />
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[

See https://nf-co.re/stableexpression/ for detailed documentation

     ]]></help>
