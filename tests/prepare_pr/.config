process {

    publishDir = [
        path: {
            try {
                meta.section ?
                "${params.outdir}/${meta.section}/${task.process.tokenize(':')[-1].toLowerCase()}" :
                "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}"
            } catch (e) {
                "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}"
            }
        },
        mode: 'copy',
    ]
}
