nextflow_workflow {

    name "Test Workflow EXPRESSION_NORMALISATION"
    script "subworkflows/local/expression_normalisation/main.nf"
    workflow "EXPRESSION_NORMALISATION"
    tag "subworkflow_expression_normalisation"
    tag "subworkflow"

    test("GeTMM") {

        when {
            workflow {
                """
                input[0] = "solanum_tuberosum"
                input[1] = channel.of(
                    [
                        [
                            normalised: false,
                            design: file( '$projectDir/tests/test_data/workflows/sampled/solanum_tuberosum/rnaseq.raw.design.csv', checkIfExists: true ),
                            dataset: "rnaseq_raw",
                            platform: "rnaseq"
                        ],
                        file( '$projectDir/tests/test_data/workflows/sampled/solanum_tuberosum/rnaseq.raw.csv', checkIfExists: true )
                    ]
                )
                input[2] = channel.fromPath( '$projectDir/tests/test_data/workflows/sampled/solanum_tuberosum/valid_gene_ids.txt', checkIfExists: true )
                input[3] = false
                input[4] = false
                input[5] = "uniform"
                input[6] = null
                input[7] = null
                input[8] = null
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }

    }

    test("GeTMM + TPM - skip quantile normalisation") {

        when {
            workflow {
                """
                input[0] = "solanum_tuberosum"
                input[1] = channel.of(
                    [
                        [
                            normalised: false,
                            design: file( '$projectDir/tests/test_data/workflows/sampled/solanum_tuberosum/rnaseq.raw.design.csv', checkIfExists: true ),
                            dataset: "rnaseq_raw",
                            platform: "rnaseq"
                        ],
                        file( '$projectDir/tests/test_data/workflows/sampled/solanum_tuberosum/rnaseq.raw.csv', checkIfExists: true )
                    ],
                    [
                        [
                            normalised: true,
                            design: file( '$projectDir/tests/test_data/workflows/sampled/solanum_tuberosum/microarray.normalised.design.csv', checkIfExists: true ),
                            dataset: "microarray_normalised",
                            platform: "microarray"
                        ],
                        file( '$projectDir/tests/test_data/workflows/sampled/solanum_tuberosum/microarray.normalised.csv', checkIfExists: true )
                    ]
                )
                input[2] = channel.fromPath( '$projectDir/tests/test_data/workflows/sampled/solanum_tuberosum/valid_gene_ids.txt', checkIfExists: true )
                input[3] = false
                input[4] = true
                input[5] = "uniform"
                input[6] = null
                input[7] = null
                input[8] = null
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }

    }

    test("CPM Normalisation - Quantile normalisation to normal distribution") {

        when {
            workflow {
                """
                input[0] = "solanum_tuberosum"
                input[1] = channel.of(
                    [
                        [
                            normalised: false,
                            design: file( '$projectDir/tests/test_data/workflows/sampled/solanum_tuberosum/rnaseq.raw.design.csv', checkIfExists: true ),
                            dataset: "rnaseq_raw",
                            platform: "rnaseq"
                        ],
                        file( '$projectDir/tests/test_data/workflows/sampled/solanum_tuberosum/rnaseq.raw.csv', checkIfExists: true )
                    ],
                    [
                        [
                            normalised: true,
                            design: file( '$projectDir/tests/test_data/workflows/sampled/solanum_tuberosum/microarray.normalised.design.csv', checkIfExists: true ),
                            dataset: "microarray_normalised",
                            platform: "microarray"
                        ],
                        file( '$projectDir/tests/test_data/workflows/sampled/solanum_tuberosum/microarray.normalised.csv', checkIfExists: true )
                    ]
                )
                input[2] = channel.fromPath( '$projectDir/tests/test_data/workflows/sampled/solanum_tuberosum/valid_gene_ids.txt', checkIfExists: true )
                input[3] = true
                input[4] = false
                input[5] = "normal"
                input[6] = null
                input[7] = null
                input[8] = null
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }

    }

    test("No rnaseq normalisation") {

        when {
            workflow {
                """
                input[0] = "solanum_tuberosum"
                input[1] = channel.of(
                    [
                        [
                            normalised: true,
                            design: file( '$projectDir/tests/test_data/workflows/sampled/solanum_tuberosum/microarray.normalised.design.csv', checkIfExists: true ),
                            dataset: "microarray_normalised",
                            platform: "microarray"
                        ],
                        file( '$projectDir/tests/test_data/workflows/sampled/solanum_tuberosum/microarray.normalised.csv', checkIfExists: true )
                    ]
                )
                input[2] = channel.fromPath( '$projectDir/tests/test_data/workflows/sampled/solanum_tuberosum/valid_gene_ids.txt', checkIfExists: true )
                input[3] = "getmm"
                input[5] = "uniform"
                input[6] = null
                input[7] = null
                input[8] = null
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }

    }

}
