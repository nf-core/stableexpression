nextflow_workflow {

    name "Test Workflow GENORM"
    script "subworkflows/local/genorm/main.nf"
    workflow "GENORM"
    tag "subworkflow_genorm"
    tag "subworkflow"

    test("10 genes") {

        tag "subworkflow_genorm_10_genes"

        when {
            workflow {
                """
                input[0] = channel.of([
                    [section: "section_1"],
                    file( '$projectDir/tests/test_data/modules/genorm/make_chunks/input/counts.head.parquet', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

    test("1000 genes") {

        tag "subworkflow_genorm_1000_genes"

        when {
            workflow {
                """
                input[0] = channel.of( [
                    [section: "section_1"],
                    file( '$projectDir/tests/test_data/modules/genorm/make_chunks/input/counts.parquet', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
