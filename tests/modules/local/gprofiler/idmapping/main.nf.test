nextflow_process {

    name "Test Process GPROFILER_IDMAPPING"
    script "modules/local/gprofiler/idmapping/main.nf"
    process "GPROFILER_IDMAPPING"
    tag "gprofiler_idmapping"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                input[0] = file("$projectDir/tests/test_data/idmapping/gene_ids/gene_ids.txt", checkIfExists: true)
                input[1] = "Solanum tuberosum"
                input[2] = "ENTREZGENE"
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
