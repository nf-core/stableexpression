nextflow_process {

    name "Test Process GENORM"
    script "modules/local/genorm/main.nf"
    process "GENORM"

    test("Should not fail") {

        when {
            process {
                """
                input[0] = [
                    [section: "section_1"],
                    file( '$projectDir/tests/test_data/modules/genorm/make_chunks/input/counts.parquet', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
