nextflow_process {

    name "Test Process COMPUTE_M_MEASURE"
    script "modules/local/genorm/compute_m_measure/main.nf"
    process "COMPUTE_M_MEASURE"
    tag "m_measure"

    test("Four initial chunk files") {

        when {
            process {
                """
                input[0] = [
                    [section: "section_1"],
                    file( '$projectDir/tests/test_data/modules/genorm/compute_m_measure/input/std.*.parquet', checkIfExists: true).collect()
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
