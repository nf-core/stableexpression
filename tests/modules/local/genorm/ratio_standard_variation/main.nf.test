nextflow_process {

    name "Test Process RATIO_STANDARD_VARIATION"
    script "modules/local/genorm/ratio_standard_variation/main.nf"
    process "RATIO_STANDARD_VARIATION"
    tag "ratio_std"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = [
                    [section: "section_1", index_1: 0, index_2: 1],
                    file( '$projectDir/tests/test_data/genorm/expression_ratio/output/ratios.0.1.parquet', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
