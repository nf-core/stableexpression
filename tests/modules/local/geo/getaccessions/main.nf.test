nextflow_process {

    name "Test Process GEO_GETACCESSIONS"
    script "modules/local/geo/getaccessions/main.nf"
    process "GEO_GETACCESSIONS"
    tag "geo_getaccession"

    test("Beta vulgaris - exclude two accessions") {

        when {
            process {
                """
                input[0] = "beta_vulgaris"
                input[1] = ""
                input[2] = []
                input[3] = file( '$projectDir/tests/test_data/modules/geo/exclude_one_geo_accession.txt', checkIfExists: true )
                input[4] = 100
                input[5] = 42
                """
            }
        }

        then {
            assert process.success
        }

    }

    test("Beta vulgaris - leaf / microarray") {

        when {
            process {
                """
                input[0] = "beta_vulgaris"
                input[1] = "leaf"
                input[2] = "microarray"
                input[3] = []
                input[4] = 100
                input[5] = 42
                """
            }
        }

        then {
            assert process.success
        }

    }

    test("Beta vulgaris - leaf / microarray") {

        when {
            process {
                """
                input[0] = "beta_vulgaris"
                input[1] = "leaf"
                input[2] = "microarray"
                input[3] = []
                input[4] = 100
                input[5] = 42
                """
            }
        }

        then {
            assert process.success
        }

    }

}
