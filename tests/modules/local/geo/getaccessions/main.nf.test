nextflow_process {

    name "Test Process GEO_GETACCESSIONS"
    script "modules/local/geo/getaccessions/main.nf"
    process "GEO_GETACCESSIONS"
    tag "geo_getaccession"

    test("Beta vulgaris") {

        when {
            process {
                """
                input[0] = "beta_vulgaris"
                input[1] = ""
                input[2] = "none"
                input[3] = file( '$projectDir/tests/test_data/geo/get_accessions/exclude_no_accessions.txt', checkIfExists: true )
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
