                    "GSE59707"
                ]
                input[1] = "drosophila_simulans"
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }
*/
    test("Drosophila simulans - No data found") {

        when {

            process {
                """
                input[0] = [
                    [ id: "test" ],
                    "GSE124142"
                ]
                input[1] = "drosophila_simulans"
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("Drosophila simulans - Expression profiling by array") {

        when {

            process {
                """
                input[0] = [
                    [ id: "test" ],
                    "GSE43665"
                ]
                input[1] = "drosophila_simulans"
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("Drosophila simulans - Expression profiling by high throughput sequencing / Some raw counts found") {

        when {

            process {
                """
                input[0] = [
                    [ id: "test" ],
                    "GSE59707"
                ]
                input[1] = "drosophila_simulans"
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("Drosophila simulans - Expression profiling by high throughput sequencing / One raw count found") {

        when {

            process {
                """
                input[0] = [
                    [ id: "test" ],
                    "GSE100837"
                ]
                input[1] = "drosophila_simulans"
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("Drosophila simulans - Only series suppl data but multiple species") {

        when {

            process {
                """
                input[0] = [
                    [ id: "test" ],
                    "GSE274048"
                ]
                input[1] = "drosophila_simulans"
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.counts.size() == 0 },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
