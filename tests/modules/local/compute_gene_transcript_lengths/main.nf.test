nextflow_process {

    name "Test Process COMPUTE_GENE_TRANSCRIPT_LENGTHS"
    script "modules/local/compute_gene_transcript_lengths/main.nf"
    process "COMPUTE_GENE_TRANSCRIPT_LENGTHS"
    tag "compute_gene_transcript_lengths"

    test("Solanum tuberosum") {

        when {
            process {
                """
                input[0] = channel.fromPath( 'https://ftp.ebi.ac.uk/ensemblgenomes/pub/current/plants/gff3/solanum_tuberosum/Solanum_tuberosum.SolTub_3.0.63.chr.gff3.gz', checkIfExists: true )
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
            def transcript_lengths_file = process.out.csv[0]
            with( path(transcript_lengths_file).csv ) {
                assert rowCount == 38696
                assert columnCount == 2
            }
            def table = path(transcript_lengths_file).csv.table
            with( table ) {
                assert table.where(table.stringColumn("gene_id").isEqualTo("PGSC0003DMG400022788")).intColumn("length").get(0) == 3213
                assert table.where(table.stringColumn("gene_id").isEqualTo("ENSRNA049453121")).intColumn("length").get(0) == 130
            }

        }

    }

}
