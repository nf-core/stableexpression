nextflow_process {

    name "Test Process GLOBAL_STABILITY_SCORE"
    script "modules/local/stability_scores/global/main.nf"
    process "GLOBAL_STABILITY_SCORE"

    test("Two platforms - default weights") {

        when {
            process {
                """
                input[0] = [
                    [section: "section_1"],
                    [
                        file( '$projectDir/tests/test_data/modules/stability_scores/platform/rnaseq.section_1.stats_with_scores.csv', checkIfExists: true),
                        file( '$projectDir/tests/test_data/modules/stability_scores/platform/microarray.section_1.stats_with_scores.csv', checkIfExists: true)
                    ]
                ]
                input[1] = file( '$projectDir/tests/test_data/modules/stability_scores/platform/nb_samples_per_platform.csv', checkIfExists: true)
                input[2] = 0.7
                input[3] = 3
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("One platform - custom weights") {

        when {
            process {
                """
                input[0] = [
                    [section: "section_1"],
                    file( '$projectDir/tests/test_data/modules/stability_scores/platform/rnaseq.section_1.stats_with_scores.csv', checkIfExists: true)
                ]
                input[1] = file( '$projectDir/tests/test_data/modules/stability_scores/platform/nb_samples_per_platform.csv', checkIfExists: true)
                input[2] = 1.5
                input[3] = 0.5
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
