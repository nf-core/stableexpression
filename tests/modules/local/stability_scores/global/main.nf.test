nextflow_process {

    name "Test Process GLOBAL_STABILITY_SCORE"
    script "modules/local/stability_scores/global/main.nf"
    process "GLOBAL_STABILITY_SCORE"
    tag "global_stability_score"

    test("Two platforms - default weights") {

        when {
            params {
                stability_score_std_penalty_weight = 0.7
                stability_score_null_penalty_weight = 3
            }
            process {
                """
                input[0] = [
                    [section: "section_1"],
                    [
                        file( '$projectDir/tests/test_data/modules/stability_scores/platform/rnaseq.section_1.stats_with_scores.parquet', checkIfExists: true),
                        file( '$projectDir/tests/test_data/modules/stability_scores/platform/microarray.section_1.stats_with_scores.parquet', checkIfExists: true)
                    ]
                ]
                input[1] = file( '$projectDir/tests/test_data/modules/stability_scores/platform/nb_samples_per_platform.csv', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("One platform - custom weights") {

        when {
            params {
                stability_score_std_penalty_weight = 1.5
                stability_score_null_penalty_weight = 0.5
            }
            process {
                """
                input[0] = [
                    [section: "section_1"],
                    file( '$projectDir/tests/test_data/modules/stability_scores/platform/rnaseq.section_1.stats_with_scores.parquet', checkIfExists: true)
                ]
                input[1] = file( '$projectDir/tests/test_data/modules/stability_scores/platform/nb_samples_per_platform.csv', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
