nextflow_process {

    name "Test Process COMPUTE_DATASET_STATISTICS"
    script "modules/local/compute_dataset_statistics/main.nf"
    process "COMPUTE_DATASET_STATISTICS"
    tag "dataset_stats"


    test("Should not fail") {

        when {
            process {
                """
                input[0] = [
                     [dataset: 'test'],
                     file( '$projectDir/tests/test_data/modules/dataset_statistics/input/count.raw.cpm.quant_norm.parquet', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

}
