nextflow_process {

    name "Test Process EXPRESSIONATLAS_GETACCESSIONS"
    script "modules/local/expressionatlas/getaccessions/main.nf"
    process "EXPRESSIONATLAS_GETACCESSIONS"
    tag "eatlas_getaccessions"

    test("Beta vulgaris one keyword - no platform") {

        when {
            params{
                platform = null
                keywords = "leaf"
                random_sampling_size = 100
                random_sampling_seed = 42
            }
            process {
                """
                input[0] = "beta_vulgaris"
                """
            }
        }

        then {
            assert process.success
            def accessions = file(process.out.accessions.get(0)).readLines()
            assert accessions.contains('E-MTAB-8187')
        }

    }

    test("Beta vulgaris no keyword - rnaseq platform") {

        when {
            params{
                platform = "rnaseq"
                keywords = ""
                random_sampling_size = 100
                random_sampling_seed = 42
            }
            process {
                """
                input[0] = "beta_vulgaris"
                """
            }
        }

        then {
            assert process.success
            def accessions = file(process.out.accessions.get(0)).readLines()
            def expected_accessions = ['E-MTAB-8187', 'E-ENAD-2']
            assert expected_accessions.each { acc -> accessions.contains(acc) }
        }

    }

    test("Beta vulgaris - no experiments left after random sampling") {

        when {
            params{
                platform = null
                keywords = ""
                random_sampling_size = 1
                random_sampling_seed = 42
            }
            process {
                """
                input[0] = "beta_vulgaris"
                """
            }
        }

        then {
            assert process.success
            def accessions = file(process.out.accessions.get(0)).readLines()
            def expected_accessions = ['E-MTAB-8187', 'E-ENAD-2']
            assert expected_accessions.each { acc -> accessions.contains(acc) }
        }

    }

    test('Solanum tuberosum two keywords - rnaseq') {

        when {
            params{
                platform = "rnaseq"
                keywords = "phloem"
                random_sampling_size = 10000
                random_sampling_seed = 42
            }
            process {
                """
                input[0] = "solanum_tuberosum"
                """
            }
        }

        then {
            assert process.success
            def accessions = file(process.out.accessions.get(0)).readLines()
            assert accessions.contains('E-MTAB-4251')
        }

    }

    test('Homo sapiens with two keywords') {

        when {
            params{
                platform = null
                keywords = "cancer,tumor"
                random_sampling_size = 100000
                random_sampling_seed = 42
            }
            process {
                """
                input[0] = "homo_sapiens"
                """
            }
        }

        then {
            assert process.success
            def accessions = file(process.out.accessions.get(0)).readLines()
            def valid_accessions = path("${projectDir}/tests/test_data/modules/expressionatlas/valid_accessions.txt.gz").linesGzip
            // the valid accessions should be a subset of the output accessions
            assert valid_accessions.each { acc -> accessions.contains(acc) }
        }

    }

}
