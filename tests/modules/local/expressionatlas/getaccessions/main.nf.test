nextflow_process {

    name "Test Process EXPRESSIONATLAS_GETACCESSIONS"
    script "modules/local/expressionatlas/getaccessions/main.nf"
    process "EXPRESSIONATLAS_GETACCESSIONS"
    tag "eatlas_getaccessions"

    test("Beta vulgaris one keyword - no platform") {

        when {
            params{
                platform = null
                keywords = "leaf"
                random_sampling_size = 100
                random_sampling_seed = 42
            }
            process {
                """
                input[0] = "beta_vulgaris"
                """
            }
        }

        then {
            assert process.success
        }

    }

    test("Beta vulgaris no keyword - rnaseq platform") {

        when {
            params{
                platform = "rnaseq"
                keywords = ""
                random_sampling_size = 100
                random_sampling_seed = 42
            }
            process {
                """
                input[0] = "beta_vulgaris"
                """
            }
        }

        then {
            assert process.success
        }

    }

    test("Beta vulgaris - no experiments left after random sampling") {

        when {
            params{
                platform = null
                keywords = ""
                random_sampling_size = 1
                random_sampling_seed = 42
            }
            process {
                """
                input[0] = "beta_vulgaris"
                """
            }
        }

        then {
            assert process.success
        }

    }

    test('Solanum tuberosum two keywords - microarray') {

        when {
            params{
                platform = "microarray"
                keywords = "potato,phloem"
                random_sampling_size = 10000
                random_sampling_seed = 42
            }
            process {
                """
                input[0] = "solanum_tuberosum"
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test('Solanum tuberosum no keyword') {

        when {
            params{
                platform = "microarray"
                keywords = ""
                random_sampling_size = 100
                random_sampling_seed = 42
            }
            process {
                """
                input[0] = "solanum_tuberosum"
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
