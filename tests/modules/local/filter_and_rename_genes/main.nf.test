nextflow_process {

    name "Test Process FILTER_RENAME_GENE_IDS"
    script "modules/local/filter_rename_gene_ids/main.nf"
    process "FILTER_RENAME_GENE_IDS"
    tag "filter_rename_gene_ids"

    test("Map Ensembl IDs") {

        when {
            process {
                """
                input[0] = channel.of(
                    [
                        [ dataset: "test" ],
                        file("$projectDir/tests/test_data/modules/idmapping/base/counts.ensembl_ids.csv", checkIfExists: true)
                    ]
                )
                input[1] = file("$projectDir/tests/test_data/modules/idmapping/mapped/mapped_gene_ids.csv", checkIfExists: true)
                input[2] = file("$projectDir/tests/test_data/modules/idmapping/mapped/valid_gene_ids.txt", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("No valid gene") {

        when {
            process {
                """
                input[0] = channel.of(
                    [
                        [ dataset: "test" ],
                        file("$projectDir/tests/test_data/modules/idmapping/base/counts.ensembl_ids.csv", checkIfExists: true)
                    ]
                )
                input[1] = file("$projectDir/tests/test_data/modules/idmapping/mapped/mapped_gene_ids.csv", checkIfExists: true)
                input[2] = file("$projectDir/tests/test_data/modules/idmapping/mapped/no_valid_gene_id.txt", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("Custom mapping - TSV") {

        tag "custom_mapping_tsv"

        when {
            process {
                """
                input[0] = channel.of(
                    [
                        [ dataset: "test" ],
                        file("$projectDir/tests/test_data/modules/idmapping/tsv/counts.ensembl_ids.tsv", checkIfExists: true)
                    ]
                )
                input[1] = file( "$projectDir/tests/test_data/modules/idmapping/tsv/mapping.tsv", checkIfExists: true)
                input[2] = file("$projectDir/tests/test_data/modules/idmapping/tsv/valid_gene_ids.txt", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
