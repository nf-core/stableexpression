nextflow_process {

    name "Test Process DATASET_STATISTICS"
    script "modules/local/dataset_statistics/main.nf"
    process "DATASET_STATISTICS"
    tag "dataset_statistics"

    test("Uniform distribution") {

        when {
            process {
                """
                input[0] = [
                     [dataset: 'test'],
                     file( '$projectDir/tests/test_data/dataset_statistics/input/count.raw.cpm.quant_norm.parquet', checkIfExists: true)
                ]
                input[1] = "uniform"
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("Normal distribution") {

        when {
            process {
                """
                input[0] = [
                     [dataset: 'test'],
                     file( '$projectDir/tests/test_data/dataset_statistics/input/count.raw.cpm.quant_norm.parquet', checkIfExists: true)
                ]
                input[1] = "normal"
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
