nextflow_process {

    name "Test Process NORMALISATION_EDGER_LOG2"
    script "modules/local/normalisation/edger_log2/main.nf"
    process "NORMALISATION_EDGER_LOG2"


    test("RPK") {

        when {

            process {
                """
                input[0] = [
                    [ dataset: "accession" ],
                    file('$projectDir/tests/test_data/modules/normalisation/base/rpk.parquet')
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("Integers") {

        when {

            process {
                """
                input[0] = [
                    [ dataset: "test" ],
                    file('$projectDir/tests/test_data/modules/normalisation/base/counts.parquet')
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("Rows with many zeros") {

        when {

            process {
                """
                input[0] = [
                    [ dataset: "test"],
                    file('$projectDir/tests/test_data/modules/normalisation/many_zeros/counts.parquet')
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
