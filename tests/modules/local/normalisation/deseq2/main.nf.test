nextflow_process {

    name "Test Process NORMALISATION_DESEQ2"
    script "modules/local/normalisation/deseq2/main.nf"
    process "NORMALISATION_DESEQ2"
    tag "deseq2"

    test("Very small dataset") {

        when {

            process {
                """
                input[0] = [
                    [ accession: "test" ],
                    file('$projectDir/tests/test_data/normalisation/base/counts.csv'),
                    file('$projectDir/tests/test_data/normalisation/base/design.csv')
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.cpm).match() }
            )
        }

    }

    test("Rows with many zeros") {

        tag "deseq2_many_zeros"

        when {

            process {
                """
                input[0] = [
                    [ accession: "test"],
                    file('$projectDir/tests/test_data/normalisation/many_zeros/counts.csv'),
                    file('$projectDir/tests/test_data/normalisation/many_zeros/design.csv')
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.cpm).match() }
            )
        }

    }

    test("One group") {

        when {

            process {
                """
                input[0] = [
                    [ accession: "accession" ],
                    file('$projectDir/tests/test_data/normalisation/one_group/counts.csv'),
                    file('$projectDir/tests/test_data/normalisation/one_group/design.csv')
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.cpm).match() }
            )
        }

    }

    test("TSV files") {

        when {

            process {
                """
                input[0] = [
                    [ accession: "accession" ],
                    file('$projectDir/tests/test_data/normalisation/base/counts.tsv'),
                    file('$projectDir/tests/test_data/normalisation/base/design.tsv')
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.cpm).match() }
            )
        }

    }

}
