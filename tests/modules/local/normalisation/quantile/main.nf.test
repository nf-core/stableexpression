nextflow_process {

    name "Test Process QUANTILE_NORMALISATION"
    script "modules/local/normalisation/quantile/main.nf"
    process "QUANTILE_NORMALISATION"
    tag "quant_norm"

    test("Uniform target distribution") {

        when {
            process {
                """
                input[0] = [
                    [dataset: 'test'],
                    file( '$projectDir/tests/test_data/modules/quantile_normalisation/count.raw.cpm.csv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
