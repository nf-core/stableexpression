nextflow_process {

    name "Test Process NORMALISATION_TPM_LOG2"
    script "modules/local/normalisation/tpm_log2/main.nf"
    process "NORMALISATION_TPM_LOG2"


    test("CSV") {

        when {

            process {
                """
                input[0] = [
                    [ dataset: "accession" ],
                    file('$projectDir/tests/test_data/modules/normalisation/base/pseudocounts.csv')
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("TPM - TSV file") {

        when {

            process {
                """
                input[0] = [
                    [ dataset: "test" ],
                    file('$projectDir/tests/test_data/modules/normalisation/base/tpm.tsv')
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }


}
