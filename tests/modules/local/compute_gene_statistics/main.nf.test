nextflow_process {

    name "Test Process COMPUTE_GENE_STATISTICS"
    script "modules/local/compute_gene_statistics/main.nf"
    process "COMPUTE_GENE_STATISTICS"
    tag "gene_stats"

    test("With imputed values") {

        when {
            params {
                max_null_ratio_valid_sample = 0.2
            }
            process {
                """
                input[0] = [
                    [ platform: 'rnaseq' ],
                    file( '$projectDir/tests/test_data/modules/dataset_statistics/input/count.raw.cpm.quant_norm.parquet', checkIfExists: true),
                    file( '$projectDir/tests/test_data/modules/dataset_statistics/input/count2.raw.cpm.quant_norm.parquet', checkIfExists: true)
                ]
                input[1] = file( '$projectDir/tests/test_data/modules/compute_gene_statistics/input/ratio_nulls_per_sample.csv', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
