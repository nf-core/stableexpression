nextflow_process {

    name "Test Process AGGREGATE_RESULTS"
    script "modules/local/aggregate_results/main.nf"
    process "AGGREGATE_RESULTS"
    tag "aggregate_results"

    test("Without targets") {

        when {
            params {
                 multiqc_nb_genes_plotted = 10
            }
            process {
                """
                input[0] = file( '$projectDir/tests/test_data/modules/dataset_statistics/input/count.raw.cpm.quant_norm.parquet', checkIfExists: true)
                input[1] = [
                    file( '$projectDir/tests/test_data/modules/aggregate_results/section_1.stats_with_scores.parquet', checkIfExists: true),
                    file( '$projectDir/tests/test_data/modules/aggregate_results/section_2.stats_with_scores.parquet', checkIfExists: true)
                ]
                input[2] = []
                input[3] = file( '$projectDir/tests/test_data/modules/aggregate_results/metadata.csv', checkIfExists: true)
                input[4] = file( '$projectDir/tests/test_data/modules/aggregate_results/mapping.csv', checkIfExists: true)
                input[5] = file( '$projectDir/assets/multiqc_config.custom_content.template.yaml', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("With valid target genes") {

        when {
            params {
                 multiqc_nb_genes_plotted = 1
            }
            process {
                """
                input[0] = file( '$projectDir/tests/test_data/modules/dataset_statistics/input/count.raw.cpm.quant_norm.parquet', checkIfExists: true)
                input[1] = [
                    file( '$projectDir/tests/test_data/modules/aggregate_results/section_1.stats_with_scores.parquet', checkIfExists: true),
                    file( '$projectDir/tests/test_data/modules/aggregate_results/section_2.stats_with_scores.parquet', checkIfExists: true)
                ]
                input[2] = ["ENSRNA049454747", "ENSRNA049434246"]
                input[3] = file( '$projectDir/tests/test_data/modules/aggregate_results/metadata.csv', checkIfExists: true)
                input[4] = file( '$projectDir/tests/test_data/modules/aggregate_results/mapping.csv', checkIfExists: true)
                input[5] = file( '$projectDir/assets/multiqc_config.custom_content.template.yaml', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("One invalid target gene - no metadata") {

        when {
            params {
                 multiqc_nb_genes_plotted = 20
            }
            process {
                """
                input[0] = file( '$projectDir/tests/test_data/modules/dataset_statistics/input/count.raw.cpm.quant_norm.parquet', checkIfExists: true)
                input[1] = [
                    file( '$projectDir/tests/test_data/modules/aggregate_results/section_1.stats_with_scores.parquet', checkIfExists: true),
                    file( '$projectDir/tests/test_data/modules/aggregate_results/section_2.stats_with_scores.parquet', checkIfExists: true)
                ]
                input[2] = ["ENSRNA049454747", "UNKNOWNGENEID1234"]
                input[3] = []
                input[4] = file( '$projectDir/tests/test_data/modules/aggregate_results/mapping.csv', checkIfExists: true)
                input[5] = file( '$projectDir/assets/multiqc_config.custom_content.template.yaml', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("One section - no mapping") {

        when {
            params {
                 multiqc_nb_genes_plotted = 0
            }
            process {
                """
                input[0] = file( '$projectDir/tests/test_data/modules/dataset_statistics/input/count.raw.cpm.quant_norm.parquet', checkIfExists: true)
                input[1] = file( '$projectDir/tests/test_data/modules/aggregate_results/section_1.stats_with_scores.parquet', checkIfExists: true)
                input[2] = []
                input[3] = file( '$projectDir/tests/test_data/modules/aggregate_results/metadata.csv', checkIfExists: true)
                input[4] = []
                input[5] = file( '$projectDir/assets/multiqc_config.custom_content.template.yaml', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
