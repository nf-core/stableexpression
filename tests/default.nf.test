nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {
        tag "test"

        when {
            params {
                species = 'prunus persica'
                gff_url = 'https://ftp.ebi.ac.uk/ensemblgenomes/pub/release-63/plants/gff3/prunus_persica/Prunus_persica.Prunus_persica_NCBIv2.63.gff3.gz'
                outdir = "$outputDir"
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    stable_name,
                    stable_path
                ).match() }
            )
            // checking that the gene summary file keeps the same number of rows, columns
            // and that some specific genes have the expected values
            def gene_summary_file = "${params.outdir}/reporting/all_genes_summary.csv"
            with( path(gene_summary_file).csv ) {
                assert rowCount == 27849
                assert columnCount == 35
            }
            def table = path(gene_summary_file).csv.table
            with( table ) {
                assert table.where(table.stringColumn("gene_id").isEqualTo("ENSRNA050004025")).doubleColumn("stability_score").get(0) == 0.04468
                assert table.where(table.stringColumn("gene_id").isEqualTo("PRUPE_1G169400")).doubleColumn("stability_score").get(0) == 0.35885
                assert table.where(table.stringColumn("gene_id").isEqualTo("PRUPE_1G195800")).doubleColumn("stability_score").get(0) == 0.62329
            }
        }
    }

    test("-profile test_datasets_dsim") {
        tag "test_datasets_dsim"

        when {
            params {
                species = 'drosophila simulans'
                datasets = "${projectDir}/tests/test_data/workflows/drosophila_simulans/samplesheet.yaml"
                skip_fetch_eatlas_accessions = true
                skip_id_mapping = true
                target_genes = "FBgn0268332"
                gff_url = 'https://ftp.ebi.ac.uk/ensemblgenomes/pub/release-62/metazoa/gff3/drosophila_simulans/Drosophila_simulans.ASM75419v3.62.gff3.gz'
                nb_sections = 20
                outdir = "$outputDir"
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    stable_name,
                    stable_path
                ).match() }
            )
            // checking that the gene summary file keeps the same number of rows, columns
            // and that some specific genes have the expected values
            def gene_summary_file = "${params.outdir}/reporting/all_genes_summary.csv"
            with( path(gene_summary_file).csv ) {
                assert rowCount == 15079
                assert columnCount == 32
            }
            def table = path(gene_summary_file).csv.table
            // the candidate genes used in publications must have the expected stability scores
            with( table ) {
                assert table.where(table.stringColumn("gene_id").isEqualTo("FBgn0182068")).doubleColumn("stability_score").get(0) == 0.07614
                assert table.where(table.stringColumn("gene_id").isEqualTo("FBgn0186743")).doubleColumn("stability_score").get(0) == 0.0976
                assert table.where(table.stringColumn("gene_id").isEqualTo("FBgn0194689")).doubleColumn("stability_score").get(0) == 0.11167
                assert table.where(table.stringColumn("gene_id").isEqualTo("FBgn0181924")).doubleColumn("stability_score").get(0) == 0.1139
                assert table.where(table.stringColumn("gene_id").isEqualTo("FBgn0193626")).doubleColumn("stability_score").get(0) == 0.11688
                assert table.where(table.stringColumn("gene_id").isEqualTo("FBgn0184651")).doubleColumn("stability_score").get(0) == 0.1196
                assert table.where(table.stringColumn("gene_id").isEqualTo("FBgn0196300")).doubleColumn("stability_score").get(0) == 0.13177
                assert table.where(table.stringColumn("gene_id").isEqualTo("FBgn0185678")).doubleColumn("stability_score").get(0) == 0.13766
                assert table.where(table.stringColumn("gene_id").isEqualTo("FBgn0188440")).doubleColumn("stability_score").get(0) == 0.14392
                assert table.where(table.stringColumn("gene_id").isEqualTo("FBgn0189846")).doubleColumn("stability_score").get(0) == 0.14852
            }
        }
    }

    test("-profile test_dataset_mus_musculus") {
        tag "test_dataset_mus_musculus"

        when {
            params {
                species = 'mus musculus'
                nb_sections = 1
                nb_candidates_per_section = 1000
                datasets = "https://raw.githubusercontent.com/nf-core/test-datasets/stableexpression/test_data/mus_musculus/samplesheet.yaml"
                skip_fetch_eatlas_accessions = true
                gff_url = 'https://ftp.ensembl.org/pub/release-116/gff3/mus_musculus/Mus_musculus.GRCm39.116.gff3.gz'
                outdir = "$outputDir"
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_stableexpression_software_mqc_versions.yml"),
                    stable_name,
                    stable_path
                ).match() }
            )
            // checking that the gene summary file keeps the same number of rows, columns
            // and that some specific genes have the expected values
            def gene_summary_file = "${params.outdir}/reporting/all_genes_summary.csv"
            with( path(gene_summary_file).csv ) {
                assert rowCount == 975
                assert columnCount == 35
            }
            def table = path(gene_summary_file).csv.table
            with( table ) {
                assert table.where(table.stringColumn("gene_id").isEqualTo("ENSMUSG00000000305")).doubleColumn("stability_score").get(0) == 0.10936
                assert table.where(table.stringColumn("gene_id").isEqualTo("ENSMUSG00000034187")).doubleColumn("stability_score").get(0) == 0.00467
                assert table.where(table.stringColumn("gene_id").isEqualTo("ENSMUSG00000107358")).doubleColumn("stability_score").get(0) == 0.5805
            }
        }
    }

    test("-profile test_all_public_data_and_minimal_custom_dataset") {
        tag "test_all_public_data_and_minimal_custom_dataset"

        when {
            params {
                species = 'beta vulgaris'
                keywords = "leaf"
                fetch_geo_accessions = true
                datasets = "https://raw.githubusercontent.com/nf-core/test-datasets/stableexpression/test_data/sampled/beta_vulgaris/samplesheet.csv"
                gff_url = 'https://ftp.ebi.ac.uk/ensemblgenomes/pub/release-63/plants/gff3/beta_vulgaris/Beta_vulgaris.RefBeet-1.2.2.63.gff3.gz'
                outdir = "$outputDir"
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    stable_name,
                    stable_path
                ).match() }
            )
        }
    }

    test("-profile test_accessions_only") {
        tag "test_accessions_only"

        when {
            params {
                species = 'arabidopsis lyrata'
                accessions_only = true
                platform = 'rnaseq'
                outdir = "$outputDir"
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            assertAll(
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_stableexpression_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content
                ).match() }
            )
        }
    }

    test("-profile test_download_only") {
        tag "test_download_only"

        when {
            params {
                species = 'aspergillus fumigatus'
                download_only = true
                gff_url = 'https://ftp.ebi.ac.uk/ensemblgenomes/pub/release-63/fungi/gff3/aspergillus_fumigatus/Aspergillus_fumigatus.GCA000002655v1.63.gff3.gz'
                outdir = "$outputDir"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_stableexpression_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )
        }
    }

    test("-profile test_one_accession_low_gene_count") {
        tag "test_one_accession_low_gene_count"

        when {
            params {
                species = 'arabidopsis thaliana'
                accessions = "E-GEOD-51720"
                skip_fetch_eatlas_accessions = true
                gff_url = 'https://ftp.ebi.ac.uk/ensemblgenomes/pub/release-63/plants/gff3/arabidopsis_thaliana/Arabidopsis_thaliana.TAIR10.63.gff3.gz'
                outdir = "$outputDir"
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_stableexpression_software_mqc_versions.yml"),
                    stable_name,
                    stable_path
