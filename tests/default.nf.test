nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {
        tag "test"

        when {
            params {
                species = 'prunus persica'
                gff_url = 'https://ftp.ebi.ac.uk/ensemblgenomes/pub/release-63/plants/gff3/prunus_persica/Prunus_persica.Prunus_persica_NCBIv2.63.gff3.gz'
                outdir = "$outputDir"
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    stable_name,
                    stable_path
                ).match() }
            )
        }
    }

    test("-profile test_dataset_mus_musculus") {
        tag "test_dataset_mus_musculus"

        when {
            params {
                species = 'mus musculus'
                datasets = "https://raw.githubusercontent.com/nf-core/test-datasets/stableexpression/test_data/mus_musculus/samplesheet.yaml"
                skip_fetch_eatlas_accessions = true
                gff_url = 'https://ftp.ensembl.org/pub/release-116/gff3/mus_musculus/Mus_musculus.GRCm39.116.gff3.gz'
                outdir = "$outputDir"
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_stableexpression_software_mqc_versions.yml"),
                    stable_name,
                    stable_path
                ).match() }
            )
        }
    }

    test("-profile test_all_public_data_and_minimal_custom_dataset") {
        tag "test_all_public_data_and_minimal_custom_dataset"

        when {
            params {
                species = 'beta vulgaris'
                keywords = "leaf"
                fetch_geo_accessions = true
                datasets = "https://raw.githubusercontent.com/nf-core/test-datasets/stableexpression/test_data/sampled/beta_vulgaris/samplesheet.csv"
                gff_url = 'https://ftp.ebi.ac.uk/ensemblgenomes/pub/release-63/plants/gff3/beta_vulgaris/Beta_vulgaris.RefBeet-1.2.2.63.gff3.gz'
                outdir = "$outputDir"
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    stable_name,
                    stable_path
                ).match() }
            )
        }
    }

    test("-profile test_accessions_only") {
        tag "test_accessions_only"

        when {
            params {
                species = 'arabidopsis lyrata'
                accessions_only = true
                outdir = "$outputDir"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_stableexpression_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )
        }
    }

    test("-profile test_download_only") {
        tag "test_download_only"

        when {
            params {
                species = 'aspergillus fumigatus'
                download_only = true
                gff_url = 'https://ftp.ebi.ac.uk/ensemblgenomes/pub/release-63/fungi/gff3/aspergillus_fumigatus/Aspergillus_fumigatus.GCA000002655v1.63.gff3.gz'
                outdir = "$outputDir"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_stableexpression_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )
        }
    }

    test("-profile test_one_accession_low_gene_count") {
        tag "test_one_accession_low_gene_count"

        when {
            params {
                species = 'arabidopsis thaliana'
                accessions = "E-GEOD-51720"
                skip_fetch_eatlas_accessions = true
                gff_url = 'https://ftp.ebi.ac.uk/ensemblgenomes/pub/release-63/plants/gff3/arabidopsis_thaliana/Arabidopsis_thaliana.TAIR10.63.gff3.gz'
                outdir = "$outputDir"
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_stableexpression_software_mqc_versions.yml"),
                    stable_name,
                    stable_path
                ).match() }
            )
        }
    }

    test("-profile test_skip_id_mapping") {
        tag "test_skip_id_mapping"

        when {
            params {
                species = 'solanum tuberosum'
                datasets = "${projectDir}/tests/test_data/input_datasets/sampled/solanum_tuberosum/samplesheet.csv"
                skip_id_mapping = true
                skip_fetch_eatlas_accessions = true
                gff_url = 'https://ftp.ebi.ac.uk/ensemblgenomes/pub/release-63/plants/gff3/solanum_tuberosum/Solanum_tuberosum.SolTub_3.0.63.gff3.gz'
                outdir = "$outputDir"
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    stable_name,
                    stable_path
                ).match() }
            )
        }
    }

    test("-profile test_dataset_custom_mapping_and_gene_length") {
        tag "test_dataset_custom_mapping_and_gene_length"

        when {
            params {
                species = 'solanum tuberosum'
                datasets = "${projectDir}/tests/test_data/input_datasets/sampled/solanum_tuberosum/samplesheet.csv"
                skip_id_mapping = true
                skip_fetch_eatlas_accessions = true
                gene_id_mapping = "${projectDir}/tests/test_data/input_datasets/sampled/solanum_tuberosum/mapping.csv"
                gene_metadata = "${projectDir}/tests/test_data/input_datasets/sampled/solanum_tuberosum/metadata.csv"
                gene_length = "${projectDir}/tests/test_data/input_datasets/sampled/solanum_tuberosum/gene_lengths.csv"
                outdir = "$outputDir"
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_stableexpression_software_mqc_versions.yml"),
                    stable_name,
                    stable_path
                ).match() }
            )
        }
    }

    test("-profile test_included_and_excluded_accessions") {
        tag "test_included_and_excluded_accessions"

        when {
            params {
                species = "solanum tuberosum"
                accessions = "E-MTAB-552,E-GEOD-61690"
                excluded_accessions = "E-MTAB-4251"
                accessions_file = "${projectDir}/tests/test_data/misc/accessions_to_include.txt"
                excluded_accessions_file = "${projectDir}/tests/test_data/misc/excluded_accessions.txt"
                outdir = "$outputDir"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_stableexpression_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )
        }
    }

